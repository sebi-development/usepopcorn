#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/supabase@2.108.0/node_modules/supabase/node_modules:/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/supabase@2.108.0/node_modules:/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/supabase@2.108.0/node_modules/supabase/node_modules:/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/supabase@2.108.0/node_modules:/Users/sebik/Coding/Webdev/Fullstack/usePopcorn/usepopcorn/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../supabase/dist/supabase.js" "$@"
else
  exec node  "$basedir/../supabase/dist/supabase.js" "$@"
fi
